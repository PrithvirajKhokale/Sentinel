APP_ENV=development
SENTINEL_DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://sentinel:CHANGE_ME@127.0.0.1:5433/sentinel
API_HOST=127.0.0.1
API_PORT=8000
# Set production only behind an HTTPS hosting service; requires API token and TLS DB.
SENTINEL_API_TOKEN=
SENTINEL_ALLOWED_ORIGINS=
