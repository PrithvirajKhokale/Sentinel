# Optional. Leave unset for local dev (uses the Vite /api proxy to 127.0.0.1:8000)
# or for a static build that starts in reference-example mode.
# Set to /api/v1 for a same-origin build served by the backend.
# Never put tokens or other secrets in VITE_ variables: they ship to the browser.
VITE_API_BASE_URL=
